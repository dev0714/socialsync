# --- Supabase (uses the `socialsync` schema; storage bucket below) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=socialsync

# --- Auth (single operator) ---
SOCIALSYNC_PASSWORD=            # password to sign in
SOCIALSYNC_SESSION_SECRET=      # any long random string (signs the session cookie)

# --- AI ---
ANTHROPIC_API_KEY=              # captions (Claude)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=                  # images
IMAGE_MODEL=gpt-image-1

# --- Publishing ---
SOCIAL_TOKEN_SECRET=            # any long random string (encrypts stored OAuth tokens)
APP_BASE_URL=http://localhost:3000   # MUST match the OAuth redirect URIs

# --- Scheduling / async status (Vercel Cron) ---
CRON_SECRET=                    # required in prod; Vercel Cron sends it as a Bearer token

# Platform OAuth apps (fill in as each app review is approved)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
GOOGLE_CLIENT_ID=            # used by YouTube AND Google Business Profile (register both redirect URIs)
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private

# X (Twitter) — OAuth 2.0 with PKCE; usable write access is a paid tier
X_CLIENT_ID=
X_CLIENT_SECRET=
# Threads (Meta) — separate app from the Facebook/Instagram one
THREADS_APP_ID=
THREADS_APP_SECRET=
# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Reddit ("web app" type); User-Agent is required by Reddit's API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=socialsync/1.0 by your_reddit_username

# Bluesky and Mastodon need NO app keys — they connect in-app:
#   Bluesky:  handle + an app password (Settings → App Passwords)
#   Mastodon: instance URL + an access token (Preferences → Development)
