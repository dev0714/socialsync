# --- Supabase (uses the `socialsync` schema; storage bucket below) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=socialsync

# --- Auth (single operator) ---
SOCIALSYNC_PASSWORD=            # password to sign in
SOCIALSYNC_SESSION_SECRET=      # any long random string (signs the session cookie)

# --- AI ---
ANTHROPIC_API_KEY=              # captions (Claude)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=                  # images
IMAGE_MODEL=gpt-image-1

# --- Publishing ---
SOCIAL_TOKEN_SECRET=            # any long random string (encrypts stored OAuth tokens)
APP_BASE_URL=http://localhost:3000   # MUST match the OAuth redirect URIs

# --- Scheduling / async status (Vercel Cron) ---
CRON_SECRET=                    # required in prod; Vercel Cron sends it as a Bearer token

# Platform OAuth apps (fill in as each app review is approved)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private
