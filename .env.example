# ============================================================================
# BOOTSTRAP secrets — these MUST stay in the environment. The app needs them
# before it can read or decrypt the database, so they cannot live in Settings.
# ============================================================================

# --- Supabase (uses the `socialsync` schema; storage bucket below) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=socialsync

# --- Auth (single operator) ---
SOCIALSYNC_PASSWORD=            # password to sign in
SOCIALSYNC_SESSION_SECRET=      # any long random string (signs the session cookie)

# --- Encryption key for stored tokens AND stored settings secrets ---
SOCIAL_TOKEN_SECRET=            # any long random string — do not rotate or stored secrets break

# ============================================================================
# Everything below is now managed from the in-app ⚙️ Settings page (stored in
# the database, secrets encrypted). Setting them here still works and acts as a
# fallback / initial default — stored settings take precedence at runtime.
# ============================================================================

# --- AI ---
ANTHROPIC_API_KEY=              # captions (Claude)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=                  # images
IMAGE_MODEL=gpt-image-1

# --- Core ---
APP_BASE_URL=http://localhost:3000   # MUST match the OAuth redirect URIs
CRON_SECRET=                    # Vercel Cron sends it as a Bearer token (can also be set in Settings)

# --- Platform OAuth apps (or set them in Settings) ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
GOOGLE_CLIENT_ID=               # used by YouTube AND Google Business Profile (register both redirect URIs)
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private
X_CLIENT_ID=                    # X (Twitter) — OAuth 2.0 + PKCE; write access is a paid tier
X_CLIENT_SECRET=
THREADS_APP_ID=                 # Threads (Meta) — separate app from the Facebook/Instagram one
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=socialsync/1.0 by your_reddit_username

# Bluesky and Mastodon need NO app keys — they connect in-app:
#   Bluesky:  handle + an app password (Bluesky → Settings → App Passwords)
#   Mastodon: instance URL + an access token (Preferences → Development)
